# Desarrollo local. Copiar a .env; nunca subir .env ni BD.
APP_ENV=development
DATABASE_URL=sqlite:///./data/plaza.db
COOKIE_SECURE=false
SESSION_HOURS=8
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# PostgreSQL posterior: definir URL real en .env; no publicar credenciales.
# DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@localhost:5432/plaza_reserva
# En publicación: APP_ENV=production, COOKIE_SECURE=true, ALLOWED_HOSTS=dominio.real
# Pruebas PostgreSQL opcionales, SOLO BD descartable cuyo nombre termine _test:
# TEST_POSTGRES_URL=postgresql+psycopg://USUARIO:CLAVE@localhost:5432/plaza_reserva_test
